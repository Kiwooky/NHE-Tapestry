@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<urn:mod-cookbook:nhe-tapestry>
    a lv2:Plugin , lv2:SimulatorPlugin ;
    doap:name "Tapestry" ;
    doap:license <http://spdx.org/licenses/GPL-3.0-or-later.html> ;
    doap:maintainer [ foaf:name "New Horizon" ] ;
    rdfs:comment "Tape machines from studio reel to answering machine: wow, flutter, saturation and tape's low end." ;
    lv2:minorVersion 2 ;
    lv2:microVersion 6 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/options#options> ,
                        <http://lv2plug.in/ns/ext/urid#map> ;
    lv2:extensionData <http://lv2plug.in/ns/ext/options#interface> ;
    lv2:port [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "format" ;
        lv2:name "Format" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint
            [ rdfs:label "Studio reel" ; rdf:value 0 ] ,
            [ rdfs:label "Home reel" ; rdf:value 1 ] ,
            [ rdfs:label "Walkman" ; rdf:value 2 ] ,
            [ rdfs:label "VHS" ; rdf:value 3 ] ,
            [ rdfs:label "Pocket" ; rdf:value 4 ] ,
            [ rdfs:label "Answering" ; rdf:value 5 ] ,
            [ rdfs:label "Master" ; rdf:value 6 ] ,
            [ rdfs:label "8-track" ; rdf:value 7 ] ,
            [ rdfs:label "4-track" ; rdf:value 8 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "tape" ;
        lv2:name "Tape" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint
            [ rdfs:label "Cheap" ; rdf:value 0 ] ,
            [ rdfs:label "Ferric" ; rdf:value 1 ] ,
            [ rdfs:label "Chrome" ; rdf:value 2 ] ,
            [ rdfs:label "Metal" ; rdf:value 3 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "drive" ;
        lv2:name "Drive" ;
        lv2:default 0 ;
        lv2:minimum -12 ;
        lv2:maximum 18 ;
        units:unit units:db
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "tone" ;
        lv2:name "Tone" ;
        lv2:default 0 ;
        lv2:minimum -5 ;
        lv2:maximum 5
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "wow" ;
        lv2:name "Wow" ;
        lv2:default 100 ;
        lv2:minimum 0 ;
        lv2:maximum 200 ;
        units:unit units:pc
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "flutter" ;
        lv2:name "Flutter" ;
        lv2:default 100 ;
        lv2:minimum 0 ;
        lv2:maximum 200 ;
        units:unit units:pc
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "age" ;
        lv2:name "Age" ;
        lv2:default 3 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "hiss" ;
        lv2:name "Noise" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 100 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        units:unit units:pc
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        lv2:default 0 ;
        lv2:minimum -12 ;
        lv2:maximum 12 ;
        units:unit units:db
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "lv2_enabled" ;
        lv2:name "Enabled" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled ;
        lv2:designation lv2:enabled
    ] .
